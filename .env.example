# Copia este archivo como .env en la raíz del proyecto y ajusta los valores.
# .env está ignorado por Git: NO subas contraseñas ni llaves reales.

# --- Backend / MySQL local -------------------------------------------------
DB_URL=jdbc:mysql://localhost:3306/farma_db?useSSL=false&serverTimezone=America/Lima&allowPublicKeyRetrieval=true
DB_USERNAME=farma
DB_PASSWORD=cambiar-password-local
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false
SERVER_PORT=8081

# --- Culqi sandbox --------------------------------------------------------
# Déjalos vacíos para usar el modo de pago simulado.
CULQI_PUBLIC_KEY=
CULQI_SECRET_KEY=
CULQI_API_URL=https://api.culqi.com/v2
CULQI_MODO=

# --- Correo de confirmación ----------------------------------------------
# No requiere configuración: se envía directamente al servidor del destinatario.
# Si la red bloquea el envío, la web abre el cliente de correo como respaldo.

# --- Docker Compose -------------------------------------------------------
# El contenedor de MySQL usa MYSQL_PASSWORD = DB_PASSWORD.
MYSQL_ROOT_PASSWORD=cambiar-root-password
# El script completo crea esta base con ese nombre fijo; no lo cambies.
MYSQL_DATABASE=farma_db
MYSQL_USER=farma
FRONTEND_PORT=8080
BACKEND_PORT=8081
