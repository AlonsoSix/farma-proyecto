# Copia este archivo como application.properties y pon tu propia contraseña de MySQL.
spring.application.name=farma-backend

spring.datasource.url=jdbc:mysql://localhost:3306/farma_db?useSSL=false&serverTimezone=America/Lima
spring.datasource.username=root
spring.datasource.password=TU_CONTRASEÑA_DE_MYSQL

spring.jpa.hibernate.ddl-auto=validate
spring.jpa.show-sql=true

server.port=8081